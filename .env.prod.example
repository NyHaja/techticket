# ──────────────────────────────────────────────────────────────
# Variables de production pour docker-compose.prod.yml
#
# 1. Copier ce fichier :      cp .env.prod.example .env.prod
# 2. Remplacer TOUTES les valeurs factices ci-dessous
# 3. Lancer :                 docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
#
# ⚠️ .env.prod contient des secrets : ne jamais le commiter (il est ignoré par .gitignore).
# ⚠️ Les mots de passe sont insérés dans des URL (DATABASE_URL, REDIS_URL) :
#    utiliser uniquement des caractères sûrs (lettres et chiffres). Les commandes
#    "openssl rand -hex" ci-dessous génèrent des valeurs compatibles.
# ──────────────────────────────────────────────────────────────

# ─── Domaine ───
# Nom de domaine public pointant vers le serveur (enregistrement DNS A/AAAA).
# Caddy l'utilise pour obtenir automatiquement le certificat HTTPS.
# Local : localhost (certificat interne de Caddy)
# Production : <ip-avec-tirets>.sslip.io (certificat Let's Encrypt)
DOMAIN=localhost

# ─── PostgreSQL ───
# Nom d'utilisateur et de base : pas des secrets, choisir librement (lettres, chiffres, _).
POSTGRES_USER=techticket
POSTGRES_DB=techticket
# Générer avec : openssl rand -hex 32
POSTGRES_PASSWORD=change-me-postgres-password

# ─── Redis (stockage des sessions) ───
# Générer avec : openssl rand -hex 32
REDIS_PASSWORD=change-me-redis-password

# ─── Sessions ───
# Clé de signature des cookies de session (au moins 32 caractères).
# La changer déconnecte tous les utilisateurs.
# Générer avec : openssl rand -base64 48
SESSION_SECRET=change-me-session-secret-at-least-32-characters

# Version des images à déployer (tag GHCR : 0.1.0, sha-xxxxxxx…). Jamais "latest".
# En local avec docker-compose.build.yml : mettre "local"
TAG=0.1.0
